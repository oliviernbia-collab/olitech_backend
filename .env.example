# Serveur
PORT=5000
FRONTEND_URL=http://localhost:5173

# Authentification admin (JWT)
# JWT_SECRET : genere avec `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change_this_to_a_random_secret
# Duree de vie courte recommandee (reduit la fenetre d'exploitation si le token fuite)
JWT_EXPIRES_IN=12h

# Compte super admin cree par "npm run seed" (execute une seule fois) — NE JAMAIS
# mettre de vrais identifiants ici, ce fichier est le gabarit partage du projet.
ADMIN_NAME=Admin Name
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Base de donnees MySQL (XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_olitech

# Envoi d'email (SMTP Gmail)
# Utiliser un "mot de passe d'application" Gmail, pas le mot de passe du compte
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=

# URL publique du backend (tunnel ngrok en dev, domaine reel en prod) — utilisee
# pour les URL de redirection Jeko (HTTPS obligatoire, inatteignable en localhost)
PUBLIC_API_URL=

# Paiement Jeko (CV telechargeables) — Wave / Orange / MTN / Moov
JEKO_API_BASE_URL=https://api.jeko.africa
JEKO_API_KEY=
JEKO_API_KEY_ID=
JEKO_STORE_ID=
JEKO_WEBHOOK_SECRET=
CV_PRICE_FCFA=300

# Stockage images/videos (Cloudinary) — portfolio + photos de CV
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
